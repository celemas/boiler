{
	$schema: 'vendor/infection/infection/resources/schema.json',
	source: {
		directories: ['src'],
	},
	tmpDir: '.infection',
	logs: {
		text: '.infection/infection.log',
		html: '.infection/infection.html',
		summary: '.infection/summary.log',
	},
	// Baseline from the first run; raise these as escaped mutants are fixed or ignored.
	minMsi: 86,
	minCoveredMsi: 86,
	mutators: {
		'@default': true,
	},
}
