<nav class="site-nav" aria-label="Main">
    <ul>
        {% for item in nav %}
            <li class="{{ item.active ? 'is-active' : 'is-idle' }}">
                <a href="{{ item.url }}">{{ item.title }}</a>
                {% if item.hasChildren %}
                    <ul>
                        {% for child in item %}
                            <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
</nav>
