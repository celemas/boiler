<figure class="block-image">
    <img src="{{ block.src }}" alt="{{ block.alt }}" width="{{ block.width }}" height="{{ block.height }}" loading="lazy">
    <figcaption>
        {{ block.caption }}
        {% if block.credit is defined %}
            <small>Photo: {{ block.credit }}</small>
        {% endif %}
    </figcaption>
</figure>
