<table class="block-table">
    <thead>
        <tr>
            {% for cell in block.head %}
                <th scope="col">{{ cell }}</th>
            {% endfor %}
        </tr>
    </thead>
    <tbody>
        {% for row in block.rows %}
            <tr>
                {% for cell in row %}
                    <td>{{ cell }}</td>
                {% endfor %}
            </tr>
        {% endfor %}
    </tbody>
</table>
