{% extends 'layouts/base.html.twig' %}

{% block title %}{% block shop_title %}All products{% endblock %} | Shop{% endblock %}

{% block head %}
    {{ parent() }}
    <link rel="stylesheet" href="/css/shop.css">
{% endblock %}

{% block body_class %}page-shop{% endblock %}

{% block hero %}
    <section class="promo">
        <h2>{{ campaign.title|upper }}</h2>
        <p>
            Use code <strong>{{ campaign.code }}</strong>
            for free shipping above {{ campaign.threshold|money }}.
        </p>
        <p>Ends <time datetime="{{ campaign.endsAt|date('Y-m-d\\TH:i') }}">{{ campaign.endsAt|date('F j, H:i') }}</time></p>
    </section>
{% endblock %}

{% block content %}
    <div class="shop">
        <div class="shop-main">
            {% block shop_content %}{% endblock %}
        </div>

        <aside class="shop-sidebar">
            {% block sidebar %}
                {{ include('partials/sidebar.html.twig') }}
            {% endblock %}
        </aside>
    </div>
{% endblock %}

{% block scripts %}
    <script src="/js/shop.js"></script>
{% endblock %}
